
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#050b18">
<title>J.A.R.V.I.S.</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;background:#050b18;color:#d8f5ff;
 font-family:Arial,sans-serif;text-align:center;
 min-height:100vh;
 background:radial-gradient(circle at center,#102a46,#050b18 70%);
}
header{padding:25px 10px}
h1{letter-spacing:9px;color:#55dfff;
 text-shadow:0 0 20px #00bfff}
#status{color:#70c9e8;font-size:12px;letter-spacing:3px}
.reactor{
 width:210px;height:210px;margin:25px auto;
 border:3px solid #38caff;border-radius:50%;
 display:flex;align-items:center;justify-content:center;
 box-shadow:0 0 25px #009dff,inset 0 0 25px #009dff;
 animation:pulse 3s infinite;
}
.core{
 width:105px;height:105px;border-radius:50%;
 background:radial-gradient(circle,#fff,#32caff 30%,#075b9c 70%);
 box-shadow:0 0 35px #00bfff;
}
@keyframes pulse{
 50%{transform:scale(1.04);box-shadow:0 0 50px #00bfff}
}
#chat{
 max-width:600px;height:260px;overflow:auto;
 margin:15px auto;padding:12px;text-align:left;
 border:1px solid #174b6b;border-radius:12px;
 background:#071322;
}
.message{padding:10px;margin:8px 0;border-radius:9px;
 white-space:pre-wrap;line-height:1.5}
.user{background:#123b57;color:white}
.jarvis{background:#102b38;color:#8ce7ff}
.controls{max-width:600px;margin:auto;padding:12px}
input,button{
 padding:13px;border-radius:8px;
 border:1px solid #238ab5;background:#0b2034;
 color:white;font-size:15px;
}
input{width:100%;margin:5px 0}
button{cursor:pointer;margin:5px}
button:active{background:#17618c}
.send{background:#0876aa}
#question{width:68%}
small{color:#83a9bb}
</style>
</head>

<body>
<header>
 <h1>J.A.R.V.I.S.</h1>
 <div id="status">PERSONAL AI SYSTEM ONLINE</div>
</header>

<div class="reactor"><div class="core"></div></div>
<p>JUST A RATHER VERY INTELLIGENT SYSTEM</p>

<div id="chat">
 <div class="message jarvis">
 Good day. I am JARVIS, your personal AI assistant.
 How may I assist you today, sir?
 </div>
</div>

<div class="controls">
 <input id="question" placeholder="Speak or type to JARVIS...">
 <button class="send" onclick="sendMessage()">SEND</button>
 <button onclick="listen()">🎙 SPEAK</button>
 <button onclick="stopVoice()">🔇 STOP VOICE</button>
 <br>
 <button onclick="settings()">⚙ SETTINGS</button>
 <button onclick="clearChat()">CLEAR MEMORY</button>
 <div id="settings" style="display:none">
  <p>Gemini API key</p>
  <input id="apiKey" type="password"
  placeholder="Paste your private API key">
  <button onclick="saveKey()">SAVE KEY</button>
 </div>
 <br><small>JARVIS AI • PERSONAL EDITION</small>
</div>

<script>
const chat=document.getElementById("chat");
const question=document.getElementById("question");
let history=JSON.parse(localStorage.getItem("jarvisHistory")||"[]");
let busy=false;

function settings(){
 const s=document.getElementById("settings");
 s.style.display=s.style.display==="none"?"block":"none";
 document.getElementById("apiKey").value=
 localStorage.getItem("jarvisKey")||"";
}
function saveKey(){
 const key=document.getElementById("apiKey").value.trim();
 if(!key)return alert("Please enter your API key.");
 localStorage.setItem("jarvisKey",key);
 alert("JARVIS configuration saved.");
}
function addMessage(text,who){
 const div=document.createElement("div");
 div.className="message "+who;
 div.textContent=(who==="user"?"YOU: ":"JARVIS: ")+text;
 chat.appendChild(div);
 chat.scrollTop=chat.scrollHeight;
}
function speak(text){
 if(!window.speechSynthesis)return;
 speechSynthesis.cancel();
 const msg=new SpeechSynthesisUtterance(text);
 msg.lang="en-GB";
 msg.rate=0.92;
 msg.pitch=0.85;
 const voices=speechSynthesis.getVoices();
 const british=voices.find(v=>
  v.lang==="en-GB" && /Daniel|Oliver|Arthur/i.test(v.name)
 )||voices.find(v=>v.lang==="en-GB");
 if(british)msg.voice=british;
 speechSynthesis.speak(msg);
}
function stopVoice(){
 if(window.speechSynthesis)speechSynthesis.cancel();
}
async function sendMessage(){
 const text=question.value.trim();
 if(!text||busy)return;
 const key=localStorage.getItem("jarvisKey");
 if(!key){
  alert("Open Settings and add your Gemini API key.");
  return;
 }
 busy=true;
 question.value="";
 addMessage(text,"user");
 history.push({role:"user",parts:[{text}]});
 document.getElementById("status").textContent="PROCESSING REQUEST...";
 try{
  const response=await fetch(
   "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key="+encodeURIComponent(key),
   {
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({
     system_instruction:{
      parts:[{text:
       "You are JARVIS, a sophisticated personal AI assistant inspired by Iron Man. Speak in polished, intelligent, courteous British English. Address the user as sir occasionally, not excessively. Be helpful, concise, witty when appropriate, and honest about your capabilities. Never claim to have performed actions you cannot perform. Ask for confirmation before consequential actions."
      }]
     },
     contents:history.slice(-20),
     generationConfig:{temperature:0.8,maxOutputTokens:1000}
    })
   }
  );
  const data=await response.json();
  if(!response.ok)throw new Error(
   data.error?.message||"AI service error"
  );
  const answer=data.candidates?.[0]?.content?.parts
   ?.map(p=>p.text||"").join("\n")||"I could not generate a response.";
  history.push({role:"model",parts:[{text:answer}]});
  localStorage.setItem("jarvisHistory",JSON.stringify(history));
  addMessage(answer,"jarvis");
  speak(answer);
 }catch(error){
  addMessage("I encountered an error: "+error.message,"jarvis");
 }finally{
  busy=false;
  document.getElementById("status").textContent=
   "PERSONAL AI SYSTEM ONLINE";
 }
}
function listen(){
 const Recognition=window.SpeechRecognition||
 window.webkitSpeechRecognition;
 if(!Recognition){
  alert("Voice recognition is unavailable in this browser. Use the iPhone keyboard microphone to dictate instead.");
  question.focus();
  return;
 }
 const recognition=new Recognition();
 recognition.lang="en-GB";
 recognition.interimResults=false;
 recognition.onstart=()=>document.getElementById("status").textContent="LISTENING...";
 recognition.onresult=e=>{
  question.value=e.results[0][0].transcript;
  sendMessage();
 };
 recognition.onerror=()=>document.getElementById("status").textContent="READY";
 recognition.onend=()=>document.getElementById("status").textContent="PERSONAL AI SYSTEM ONLINE";
 recognition.start();
}
function clearChat(){
 if(!confirm("Clear your conversation memory?"))return;
 history=[];
 localStorage.removeItem("jarvisHistory");
 chat.innerHTML="";
 addMessage("Memory cleared. I am ready for your next command, sir.","jarvis");
}
question.addEventListener("keydown",e=>{
 if(e.key==="Enter")sendMessage();
});
speechSynthesis?.getVoices();
</script>
</body>
</html>
